    {
      "parameters": {
        "jsCode": "// Classify the Zoho custom-field update as SUCCESS or ERROR.\nconst res = $input.first().json || {};\nlet cn = {};\ntry { cn = $('Filter Data with no Custom Field').item.json || {}; } catch (e) {}\n\n// Zoho returns code:0 on success; HTTP node puts an `error` object on failure.\nconst isError = !!res.error || (res.code !== undefined && res.code !== 0);\nconst message = isError\n  ? (res.error?.message || res.message || 'Zoho custom-field update failed')\n  : (res.message || 'Custom field updated (cf_synced_to_netsuite = true)');\n\nreturn [{\n  json: {\n    status: isError ? 'ERROR' : 'SUCCESS',\n    creditnote_id: cn.creditnote_id || '',\n    creditnote_number: cn.creditnote_number || '',\n    customer_name: cn.customer_name || '',\n    total: cn.total || 0,\n    date: cn.date || '',\n    zoho_status: cn.status || '',\n    message,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        176
      ],
      "id": "d8397cf5-feca-4f26-b416-e8288f423adb",
      "name": "Log Result"
    },
    {
      "parameters": {
        "jsCode": "// Already-synced credit notes (cf_synced_to_netsuite = true) — input is the credit note itself.\nconst cn = $input.first().json || {};\nreturn [{\n  json: {\n    status: 'SKIPPED',\n    creditnote_id: cn.creditnote_id || '',\n    creditnote_number: cn.creditnote_number || '',\n    customer_name: cn.customer_name || '',\n    total: cn.total || 0,\n    date: cn.date || '',\n    zoho_status: cn.status || '',\n    message: 'Already synced (cf_synced_to_netsuite = true). Skipped.',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        368
      ],
      "id": "7dfca5b0-5e9b-4e0b-9a0d-4ea565035b61",
      "name": "Log Skipped"
    },
    {
      "parameters": {
        "jsCode": "// Aggregate all per-credit-note log rows collected through the loop.\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r && (r.creditnote_id || r.creditnote_number));\n\nconst total = rows.length;\nconst updated = rows.filter(r => r.status === 'SUCCESS').length;\nconst skipped = rows.filter(r => r.status === 'SKIPPED').length;\nconst failed = rows.filter(r => r.status === 'ERROR').length;\n\nreturn [{\n  json: {\n    summary: { total, updated, skipped, failed },\n    failedRows: rows.filter(r => r.status === 'ERROR'),\n    rows,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

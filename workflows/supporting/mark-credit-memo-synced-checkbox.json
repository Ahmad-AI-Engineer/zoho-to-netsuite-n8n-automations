      "name": "Set Date Range"
    },
    {
      "parameters": {
        "jsCode": "// Flatten Zoho creditnotes and keep only those inside the configured date window.\nconst range = $('Set Date Range').first().json || {};\nconst fromDate = range.from_date || '';\nconst toDate = range.to_date || '';\n\nconst allCreditNotes = [];\nfor (const item of $input.all()) {\n  const data = item.json;\n  if (data.creditnotes && Array.isArray(data.creditnotes)) {\n    data.creditnotes.forEach(creditNote => {\n      const cnDate = creditNote.date || '';\n      if (fromDate && cnDate < fromDate) return;   // before window\n      if (toDate && cnDate > toDate) return;        // after window\n      allCreditNotes.push({ json: creditNote });\n    });\n  }\n}\nreturn allCreditNotes;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        240
      ],
      "id": "0d45c4f2-fd3d-43fc-bcc5-66cf7c3034b8",
      "name": "Separate Objects"
    },
